{
  "name": "abpm-trainer-cf",
  "version": "1.0.0",
  "description": "ABPM Trainer System \u2014 Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "node --experimental-strip-types --import ./scripts/test/register.mjs scripts/test/postgrest.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "wrangler d1 execute abpm-trainer --remote --file=migrations/0001_schema.sql"
  },
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-router": "^1.133.27",
    "@tanstack/react-router-devtools": "^1.133.27",
    "@tanstack/react-start": "^1.133.27",
    "bcryptjs": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.17",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.1.15",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.106.0"
  }
}
